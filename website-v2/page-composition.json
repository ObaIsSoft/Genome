      },
      "blueprint": {
        "type": "html",
        "template": "<section class=\"hero hero-carousel\" aria-label=\"Hero\">\n  <div class=\"carousel-container\">\n    <div class=\"carousel-slides\">{{slides}}</div>\n    <button class=\"carousel-prev\" aria-label=\"Previous slide\">&lsaquo;</button>\n    <button class=\"carousel-next\" aria-label=\"Next slide\">&rsaquo;</button>\n    <div class=\"carousel-dots\">{{dots}}</div>\n  </div>\n</section>",
        "styles": ".hero-carousel { position: relative; overflow: hidden; }\n.carousel-container { position: relative; }\n.carousel-slides { display: flex; transition: transform 0.5s ease; }\n.carousel-prev, .carousel-next { position: absolute; top: 50%; transform: translateY(-50%); background: var(--color-overlay); color: var(--color-on-primary); border: none; padding: 1rem; cursor: pointer; font-size: 1.5rem; }\n.carousel-prev { left: 1rem; } .carousel-next { right: 1rem; }\n.carousel-dots { display: flex; justify-content: center; gap: 0.5rem; margin-top: 1rem; }",
        "dependencies": []
      },
      "source": "navnav"
    },
    "layout": "centered",
    "height": "compact",
    "background": "#b02440",
    "animation": {
      "type": "none",
      "entrySequence": "cascade_up",
      "staggerInterval": 35
    },
    "content": {
      "headline": "Genome: Mathematical Design DNA",
      "subheadline": "Generate unique, deterministic design systems from SHA-256 hashes and content intent",
      "cta": "Explore Genome",
      "ctaSecondary": "Learn More"
    }
